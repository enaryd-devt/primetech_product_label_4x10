<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="primetech_product_label_layout_form" model="ir.ui.view">
        <field name="name">primetech.product.label.layout.form</field>
        <field name="model">primetech.product.label.layout</field>
        <field name="arch" type="xml">
            <form string="Print Barcodes">
                <group>
                    <group>
                        <field name="quantity"/>
                        <field name="print_format" widget="radio"/>
                    </group>
                    <group>
                        <field name="pricelist_id"/>
                        <field name="extra_html"/>
                        <field name="product_tmpl_ids" widget="many2many_tags"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print" string="Confirm" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
