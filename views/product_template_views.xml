<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_barcode_print" model="ir.ui.view">
        <field name="name">product.template.form.barcode.print</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_label_layout']" position="after">
                <button name="action_open_barcode_label_layout"
                        string="Print Barcodes"
                        type="object"
                        class="btn-secondary"/>
            </xpath>
        </field>
    </record>
</odoo>
