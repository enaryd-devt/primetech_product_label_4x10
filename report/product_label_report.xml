<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The standard template renders the product name, barcode and sales
         price. This action replaces its paper format to fill the A4 sheet. -->
    <record id="action_report_product_label_4x10_price" model="ir.actions.report">
        <field name="name">Product labels 4 x 10 with price</field>
        <field name="model">product.template</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">product.report_producttemplatelabel</field>
        <field name="report_file">product.report_producttemplatelabel</field>
        <field name="paperformat_id" ref="paperformat_product_label_4x10"/>
        <field name="print_report_name">'Product Labels 4x10 - %s' % (object.display_name if object else '')</field>
    </record>
</odoo>
